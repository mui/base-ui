{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "jsx": "react-jsx",
    "module": "es2022",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  // `@base-ui/react` resolves to its source here, whose globals live in a declaration file nothing
  // imports.
  "include": ["src", "vite.config.mjs", "../../packages/react/src/global.d.ts"],
  "exclude": ["src/__bench__"],
  // Against Base UI's own typecheck project, so its sources are checked with its settings rather
  // than this harness's.
  "references": [{ "path": "../../packages/react/tsconfig.typecheck.json" }]
}
