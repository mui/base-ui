{
  "name": "docs",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "rimraf ./export && cross-env NODE_ENV=production NODE_OPTIONS=--max_old_space_size=8192 next build --webpack && pnpm link-check",
    "build:clean": "rimraf .next && pnpm build",
    "dev": "next dev --port 3005",
    "deploy": "git fetch upstream master && git push -f upstream FETCH_HEAD:docs-v1",
    "serve": "serve ./export -l 3010",
    "docs-infra": "docs-infra",
    "validate": "pnpm internal-validate --command \"pnpm validate\"",
    "internal-validate": "docs-infra validate",
    "typescript": "tsc -b tsconfig.json",
    "link-check": "tsx ./scripts/reportBrokenLinks.mts",
    "generate-llms": "node --experimental-strip-types ./scripts/generateLlmTxt/index.mjs"
  },
  "dependencies": {
    "@base-ui/react": "workspace:*",
    "@base-ui/utils": "workspace:*",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@mui/internal-docs-infra": "0.12.1-canary.42",
    "@next/mdx": "^16.3.4",
    "@react-spring/web": "^10.1.2",
    "@stefanprobst/rehype-extract-toc": "^3.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-virtual": "^3.14.11",
    "@types/mdx": "^2.0.14",
    "clipboard-copy": "^4.0.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.52.0",
    "estree-util-value-to-estree": "^3.5.0",
    "globby": "^16.2.4",
    "hast": "^1.0.0",
    "hast-util-heading-rank": "^3.0.0",
    "hast-util-to-string": "^3.0.1",
    "lucide-react": "^1.42.0",
    "lz-string": "^1.5.0",
    "match-sorter": "^8.3.0",
    "next": "16.3.4",
    "postcss": "^8.5.28",
    "postcss-custom-media": "^12.0.1",
    "postcss-import": "^17.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "6.1.5",
    "react-hook-form": "^7.87.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-typography": "0.8.5",
    "scroll-into-view-if-needed": "3.1.0",
    "server-only": "^0.0.1",
    "unist-util-visit-parents": "^6.0.2"
  },
  "devDependencies": {
    "@mdx-js/mdx": "3.1.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/gtag.js": "0.0.20",
    "@types/hast": "3.0.5",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/unist": "3.0.3",
    "cross-env": "10.1.0",
    "mdast-util-mdx-jsx": "3.2.0",
    "motion": "12.43.0",
    "prettier": "3.9.6",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "rimraf": "6.1.3",
    "serve": "14.2.6",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.5.4"
  }
}
